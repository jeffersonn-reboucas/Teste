# Secrets para Streamlit Community Cloud
# Copie este arquivo para o painel de Secrets do Streamlit Cloud

# ============================================================================
# GOOGLE DRIVE - IDs dos arquivos PDF
# ============================================================================
[gdrive]
# Para obter os File IDs:
# 1. Vá para https://drive.google.com/drive/folders/1GyE1k4Qb5Of2mAhIIYMaD3TOaJnLSB1-
# 2. Abra cada arquivo
# 3. Copie o ID da URL: https://drive.google.com/file/d/FILE_ID_AQUI/view
capovilla_file_id = "COLE_O_FILE_ID_DO_DICIONARIO_CAPOVILLA_AQUI"
config_mao_file_id = "COLE_O_FILE_ID_DO_PDF_DE_CONFIGURACOES_AQUI"

# ============================================================================
# API KEYS - SMART ROUTER (Configure quantas quiser)
# ============================================================================
[api_keys]

# Google Gemini API (Gratuito até 1500 req/dia)
# Obter em: https://makersuite.google.com/app/apikey
gemini_api_key = ""

# OpenAI API (Alta qualidade - DALL-E 3)
# Obter em: https://platform.openai.com/api-keys
openai_api_key = ""

# Replicate API Token (Flux/SDXL - Custo-benefício)
# Obter em: https://replicate.com/account/api-tokens
replicate_api_token = ""

# HuggingFace Token (Gratuito)
# Obter em: https://huggingface.co/settings/tokens
huggingface_token = ""

# Stability AI (Opcional)
# Obter em: https://platform.stability.ai/account/keys
stability_api_key = ""

# ============================================================================
# CUSTOM PROXY (Opcional - 9Router / OpenRouter)
# ============================================================================
[custom_proxy]
enabled = false
base_url = ""  # Ex: https://api.9router.com/v1
api_key = ""
model_name = "9Router"

# ============================================================================
# CONFIGURAÇÕES DO SMART ROUTER
# ============================================================================
[smart_router]
# Ordem de prioridade de fallback
# O sistema tentará na ordem até conseguir gerar
priority_order = ["gemini", "huggingface", "openai", "replicate", "pollinations"]

# Timeout para cada provider (segundos)
timeout = 120

# Número máximo de tentativas por provider
max_retries = 2

# ============================================================================
# NOTAS IMPORTANTES
# ============================================================================
#
# 1. POLLINATIONS.AI não precisa de API key (100% gratuito)
#    Sempre funciona como fallback universal
#
# 2. Configure pelo menos 1 API key para melhor qualidade
#    Mas o sistema funciona sem nenhuma (modo gratuito)
#
# 3. Smart Router NUNCA para por falta de crédito
#    Tenta automaticamente o próximo provider da lista
#
# 4. Quanto mais keys configuradas, mais resiliente o sistema
