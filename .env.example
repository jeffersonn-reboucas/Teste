# Configuração de Exemplo
# Copie este arquivo para .env e preencha com suas credenciais

# Google Gemini API
# Obter em: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=sua-api-key-do-gemini-aqui

# OpenAI API
# Obter em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sua-api-key-da-openai-aqui

# Replicate API
# Obter em: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=seu-token-do-replicate-aqui
